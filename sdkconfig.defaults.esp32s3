# ESP32-S3 N16R8 specifics. Committed. Validated by tools/check_sdkconfig.py.
#
# THE CRITICAL BLOCK IS PSRAM. The ST7701 is on the parallel RGB bus, so panel
# DMA reads the framebuffer out of PSRAM continuously (~27 MB/s at 480x480x16bpp
# x60Hz) in competition with WiFi DMA and JPEG decode. This is RISKS.md R1, the
# highest-cost risk in the project, and these settings are the levers on it.
# Phase 0 measures whether they are sufficient.

CONFIG_IDF_TARGET="esp32s3"

# --- Octal PSRAM at 80 MHz (docs/MEMORY.md §3) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Tried disabling this during Phase 0 (forces WiFi/LWIP into internal SRAM,
# off the PSRAM bus the LCD scanout uses) to see if it would fix R1's ~7%
# combined-load drop rate. Result: dropped frames only moved from ~7.0% to
# ~6.7% (within the run-to-run noise band already observed), while costing
# ~12 KiB of internal SRAM -- the resource this design is actually rationed
# against (docs/MEMORY.md §1). Not a clear enough win to keep. Reverted to
# the original `y`. If a future feature needs more PSRAM headroom than
# internal SRAM headroom, re-test this rather than assume the tradeoff still
# looks the same -- the components sharing that PSRAM bus will have changed.

# --- XiP-from-PSRAM: REQUIRED, not optional, once there is a PSRAM framebuffer ---
#
# An earlier draft of this file set FETCH_INSTRUCTIONS=n and RODATA=n, reasoning
# that keeping code/rodata off PSRAM was "the single most important R1
# mitigation" (less bus contention with the LCD scanout). That reasoning was
# incomplete, and Phase 0 caught it on first hardware boot:
#
#   Guru Meditation Error: Core 0 panic'ed (Cache error).
#   Cache disabled but cached memory region accessed
#
# Root cause: esp_flash_read() (nvs_flash_init, in this case, but equally any
# NVS write or OTA operation) briefly disables the flash/PSRAM cache while it
# talks to flash directly over SPI1 -- flash and PSRAM share the same cache
# path on ESP32-S3. If the LCD's GDMA end-of-frame ISR fires during that
# window and tries to refill its bounce buffer from the PSRAM framebuffer,
# the cache is unavailable and the core panics. This is not a rare race: on a
# 24/7 device, NVS writes (settings, WiFi state) and OTA checks are routine,
# and the display is continuously refreshing, so the two WILL collide.
#
# CONFIG_SPIRAM_XIP_FROM_PSRAM (which requires FETCH_INSTRUCTIONS + RODATA)
# is ESP-IDF's own documented fix for exactly this interaction -- see
# components/esp_lcd/test_apps/rgb_lcd/sdkconfig.defaults.esp32s3 upstream.
# A crash is strictly worse than the bus contention the old setting was
# guarding against; the contention question is now something the Phase 0
# spike measures empirically instead of something assumed away at compile
# time. See docs/MEMORY.md §3 and docs/RISKS.md R1.
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# --- Flash: 16 MB, QIO, 80 MHz ---
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_UNICORE=n

# --- LCD ISR in IRAM (docs/MEMORY.md §3) ---
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# --- Cache ---
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# --- LVGL heap ---
# Art-forward redesign: switched from LVGL's builtin TLSF allocator to the
# standard C library malloc/realloc/free. Real hardware confirmed a genuine,
# reproducible bug in this exact combination -- lv_mem_add_pool() (the
# mechanism ui_app.c previously used to hand LVGL a second, PSRAM-backed
# pool on top of the small internal-RAM one below) returned NULL for EVERY
# PSRAM address tried (confirmed at both 3 MiB and, in isolation, 64 KiB --
# not a size problem), while the identical call against a plain internal-RAM
# buffer succeeded immediately. Root cause not chased further inside TLSF's
# own block-header/pool-registration internals (out of scope for this
# redesign); CONFIG_SPIRAM_USE_MALLOC=y already makes ESP-IDF's own
# malloc()/heap_caps allocator transparently span internal RAM + PSRAM
# (confirmed: "Adding pool of 6592K of PSRAM memory to heap allocator" at
# boot) -- switching LVGL's allocator backend to just call that directly
# sidesteps the broken custom-pool path entirely, needs no lv_mem_add_pool()
# call at all (removed from ui_app.c), and is exactly the well-supported
# mechanism this project's own artwork/draw buffers already rely on.
CONFIG_LV_USE_CLIB_MALLOC=y

# LV_MEM_SIZE_KILOBYTES only matters for the builtin allocator (unused now,
# left at its real, hard-won value in case CLIB malloc is ever reverted):
# lv_init()'s own internal bootstrap (default display/group/style-cache
# setup) was confirmed to need more than Kconfig's 2 KiB floor to even
# return, and 24 KiB gave it real margin without reintroducing the old,
# unconditional 64 KiB default's internal-RAM pressure.
CONFIG_LV_MEM_SIZE_KILOBYTES=24

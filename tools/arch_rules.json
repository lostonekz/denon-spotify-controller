{
  "_comment": [
    "Allowed inter-component dependency edges. See docs/ARCHITECTURE.md §1.2.",
    "JSON, not YAML, deliberately: CI gates must run with a bare Python and no",
    "pip install. A gate with a dependency is a gate that gets skipped."
  ],

  "layers": {
    "app":  ["ui", "core", "svc", "net", "hal", "bsp", "idf"],
    "ui":   ["core", "lvgl", "idf", "ui_hal_glue"],
    "core": ["core", "idf_freertos"],
    "svc":  ["core", "net", "idf"],
    "net":  ["core", "idf"],
    "hal":  ["bsp", "idf"],
    "bsp":  ["idf"]
  },

  "component_layer": {
    "main":          "app",
    "ui":            "ui",
    "core_types":    "core",
    "core_pool":     "core",
    "core_eventbus": "core",
    "core_state":    "core",
    "core_fsm":      "core",
    "svc_denon":     "svc",
    "svc_spotify":   "svc",
    "svc_artwork":   "svc",
    "svc_ota":       "svc",
    "svc_settings":  "svc",
    "svc_storage":   "svc",
    "svc_diagnostics": "svc",
    "svc_supervisor":  "svc",
    "svc_logging":   "svc",
    "svc_scheduler": "svc",
    "net_http":      "net",
    "net_wifi":      "net",
    "net_time":      "net",
    "hal_display":   "hal",
    "hal_touch":     "hal",
    "hal_backlight": "hal",
    "bsp_board":     "bsp"
  },

  "_ui_hal_glue_comment": [
    "docs/ARCHITECTURE.md §1.2: the UI links hal_display and hal_touch ONLY for",
    "LVGL glue - flush callback, tick, input read. It may not read backlight,",
    "temperature, IMU or board revision directly; those arrive via core_state.",
    "This is a symbol-level exception, not a blanket ui -> hal edge."
  ],
  "ui_hal_glue": {
    "allowed_components": ["hal_display", "hal_touch"],
    "allowed_headers": ["hal_display.h", "hal_touch.h"]
  },

  "idf_prefixes": [
    "esp_", "freertos/", "driver/", "nvs", "lwip/", "mbedtls/", "sdkconfig.h",
    "soc/", "hal/", "spi_flash", "sys/", "lcd", "led"
  ],

  "stdlib_headers": [
    "stdio.h", "stdlib.h", "string.h", "stdint.h", "stdbool.h", "stddef.h",
    "stdarg.h", "limits.h", "math.h", "time.h", "errno.h", "assert.h",
    "inttypes.h", "ctype.h"
  ]
}

# Shared defaults. Committed. Validated by tools/check_sdkconfig.py.
# Rationale for each block is in docs/ — this file is policy, not preference.

# --- Partition table (docs/PLATFORM.md §1) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- OTA rollback (docs/PLATFORM.md §2.2) ---
# The health gate is useless without this: it is what makes a failed gate
# revert instead of reboot-looping on a broken image.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=n

# --- Signed images, development trust anchor (docs/SECURITY.md §1) ---
# Verification runs in EVERY profile. Only the key changes. A signature path
# that runs only in production has never been tested.
#
# RSA-3072, not ECDSA: ESP-IDF's SECURE_SIGNED_APPS_SCHEME choice only offers
# ECDSA (plain) on Secure Boot V1, which the ESP32-S3 does not support at all,
# and ECDSA-V2 on ESP32-C2 only. RSA-3072 is the only scheme this chip has for
# "signed apps, no secure boot." An earlier draft assumed ECDSA everywhere and
# generated a P-256 key; Kconfig silently ignored the unsatisfiable ECDSA
# symbol and fell back to its RSA default, while the actual key on disk was
# EC -- so every boot aborted in check_signature_on_update_check with "RSA
# signing scheme selected but signature block generated for ECDSA scheme".
# Caught on first hardware boot, which is exactly what Phase 0 is for.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT_SIGNING_KEY="tools/keys/dev_ota_signing.pem"

# --- eFuse: never, on development units (docs/ARCHITECTURE.md §0.1) ---
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_FLASH_ENC_ENABLED=n

# --- TLS memory (docs/MEMORY.md §4) ---
# Real bug, found live (Tier 7): this comment used to claim "Both Spotify
# and the OTA host negotiate max-fragment-length correctly; verified in
# Phase 2" -- that verification used www.google.com as the real TLS
# handshake target, never the actual Spotify/artwork hosts (Phase 4 didn't
# exist yet). Real testing against i.scdn.co (Spotify's own artwork CDN)
# found it does NOT honor the negotiated 4096-byte max-fragment-length --
# it sends full ~16KB TLS records regardless, which esp_mbedtls_dynamic_
# impl.c has to grow its receive buffer to match (confirmed by reading
# that file directly: the failing alloc size, ~16.7 KiB, is the real
# uncompressed max record size, not our requested 4096). IN raised to the
# real protocol max so a real per-record grow is what's requested up
# front, not a stressed resize under a mismatch this specific host
# doesn't respect -- the ~25 KiB/session this used to save was already
# not being saved against this host in practice, it was just failing
# instead. Internal RAM has real margin for this now (this same tier
# moved 4 task stacks to PSRAM). OUT stays reduced -- outgoing requests
# here are small GETs/PUTs, never near even 2048.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# --- Task watchdog (docs/ARCHITECTURE.md §4) ---
# A frozen wall panel is indistinguishable from dead hardware. We want a
# reboot with a coredump instead.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# --- Coredump (docs/LIFECYCLE.md §2) ---
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_SHA256=y
CONFIG_ESP_COREDUMP_STACK_SIZE=1024

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# --- LVGL (docs/ROADMAP.md Phase 5, docs/RISKS.md R9) ---
# 16-bit RGB565: the panel's own native format (bsp_pins.h's ST7701 config)
# and the same representation artwork_state_t.dominant_color_rgb565/
# artwork_cache.c's pixel buffers already use throughout this codebase --
# one color format end to end, not a conversion at the display boundary.
# Set explicitly even though it already matches LVGL's own default: R9's
# whole concern is version drift, and an explicit pin means a future LVGL
# release changing its default doesn't silently change ours too.
CONFIG_LV_COLOR_DEPTH_16=y

# Real bug, found live (Tier 7): every custom font tools/gen_assets.py
# generates (ui_font_hero/body/meta/title/label/display) is emitted in
# lv_font_conv's compressed bitmap format (bitmap_format=1 in the
# generated .c files) by default -- but this flag was never enabled, so
# LV_USE_FONT_COMPRESSED defaulted off. lv_font_get_bitmap_fmt_txt()
# (managed_components/lvgl__lvgl/src/font/fmt_txt/lv_font_fmt_txt.c) logs
# a warning and returns NULL for every glyph in that case -- no bitmap to
# draw, so every label using one of this project's own fonts rendered
# completely blank (title, artist, clock, volume), while LVGL's built-in
# default font (w_transport's LV_SYMBOL_* icons, never given an explicit
# custom font) rendered fine, which is what made this look like a data
# problem at first rather than a font-decoding one. The decompression
# code already exists in LVGL; this only turns it on.
CONFIG_LV_USE_FONT_COMPRESSED=y

# ESP-IDF build output
# `build/` is ESP-IDF's own build directory (idf.py owns it outright and
# refuses to reuse a directory that isn't purely its own). Host test builds
# therefore live in build_host/ and build_asan/, siblings rather than
# children, so the two toolchains never fight over the same root.
build/
sdkconfig
sdkconfig.old

# managed_components/ is fetched FROM dependencies.lock (like node_modules
# from package-lock.json) -- the lock file is what's committed and pinned
# (docs/ARCHITECTURE.md §7), the fetched source is not. An independent
# review caught these docs claiming dependencies.lock was committed when it
# didn't even exist yet (no managed component had been added); it's real
# now that espressif/esp_jpeg is a dependency, so this ignore entry for the
# lock file itself was removed rather than left to keep contradicting the
# docs.
managed_components/

# Host test build output
build_host/
build_asan/

# Signing keys — never commit real keys. The dev key referenced in
# sdkconfig.defaults is generated locally per docs/SECURITY.md §4 and
# tools/check_release.py enforces it never reaches a production build.
tools/keys/*.pem
tools/keys/*.der
!tools/keys/.gitkeep

# Local tool config, not project content
.claude/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Python
__pycache__/
*.pyc
